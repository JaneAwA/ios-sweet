--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -233,19 +233,23 @@
 	dwc_wr(DEPCMDPAR0(ep), p0);
 	dwc_wr(DEPCMDPAR1(ep), p1);
 	dwc_wr(DEPCMDPAR2(ep), p2);
 	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
-	for (int i = 0; i < 1000; i++) {
+	for (int i = 0; i < 100000; i++) {
 		uint32_t v = dwc_rd(DEPCMD(ep));
 		if (!(v & DEPCMD_CMDACT)) {
 			uint32_t status = (v >> 12) & 0xf;
 			if (status) {
 				printf("SWEET USB: ep%u cmd 0x%x status %u\n", ep, cmd & 0xf, status);
 				return -1;
 			}
 			return 0;
 		}
 		delay(1);
 	}
-	printf("SWEET USB: ep%u cmd 0x%x timeout\n", ep, cmd & 0xf);
+	printf("SWEET USB: ep%u cmd 0x%x timeout, DEPCMD 0x%08x PAR2 0x%08x "
+	    "DCTL 0x%08x DSTS 0x%08x\n", ep, cmd & 0xf, dwc_rd(DEPCMD(ep)),
+	    dwc_rd(DEPCMDPAR2(ep)), dwc_rd(DCTL), dwc_rd(DSTS));
 	return -1;
 }
@@ -510,5 +510,10 @@
 	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
 		return;
 	}
 
+	/* DCTL.CSFTRST can drop GCTL.PRTCAPDIR back to "idle"; with the core
+	 * not in device mode the device-side logic never runs and DEPCMD
+	 * commands time out. Re-assert device mode like Linux dwc3 does
+	 * after a core soft reset (PRTCAPDIR = bits [14:13], 01 = device). */
+	dwc_wr(GCTL, (dwc_rd(GCTL) & ~(3u << 13)) | (1u << 13));
+
 	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -282,8 +282,7 @@
 	extern int disableConsoleOutput;
 
 #if defined(ARM64_BOARD_CONFIG_SWEET)
-	sweet_log_append(c, size);
 	if (sweet_console_muted && !panic_active()) {
 		return;
 	}
 #endif
@@ -529,6 +529,13 @@
 void
 console_write(char *str, int size)
 {
 	assert(str != NULL);
 
+	#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* The video console draws straight from the console ring on this port,
+	 * so _cnputs() is never reached for normal output and the persistent
+	 * log (patch 0047) stayed empty. console_write() is the single entry
+	 * point for all console output (kernel printf and /dev/console). */
+	sweet_log_append(str, size);
+	#endif
+
 	char *write_ptr = NULL;
