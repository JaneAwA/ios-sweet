 # Headers installed into System.framework/PrivateHeaders (userspace internal SDK only).
diff --git a/pexpert/pexpert/arm64/POLARIS.h b/pexpert/pexpert/arm64/POLARIS.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/POLARIS.h
@@ -0,0 +1,30 @@
+/*
+ * Board config for the Xiaomi Mi Mix 2S ("polaris", Qualcomm SDM845 /
+ * Snapdragon 845): Kryo 385 = Cortex-A75 + Cortex-A55, ARMv8.2, no PAC.
+ *
+ * SDM845 shares SWEET's (Redmi Note 10 Pro / SM7150) Qualcomm-class plumbing:
+ * GICv3 with two security states (Group 0 owned by TrustZone, everything we
+ * own is Group 1 NS taken as an IRQ), a 19.2 MHz arch timer whose virtual
+ * timer PPI is INTID 19, and no pointer authentication. We reuse SWEET.h
+ * verbatim and only override what differs for SDM845.
+ */
+
+#ifndef _PEXPERT_ARM64_POLARIS_H
+#define _PEXPERT_ARM64_POLARIS_H
+
+#include <pexpert/arm64/SWEET.h>
+
+/* First-boot: mirror SWEET's single flat cluster (mkadt presents 8 homogeneous
+ * cores, cluster-id=0). Bump to 2 only after the ADT describes A75/A55
+ * big.LITTLE topology with real cluster-id/die-cluster-id. */
+#undef MAX_CPU_CLUSTERS
+#define MAX_CPU_CLUSTERS               1
+
+#define POLARIS                        1
+#define SDM845                         1
+
+#endif /* ! _PEXPERT_ARM64_POLARIS_H */
diff --git a/pexpert/pexpert/arm64/board_config.h b/pexpert/pexpert/arm64/board_config.h
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -97,6 +97,17 @@
 #define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
 
 #endif  /* ARM64_BOARD_CONFIG_SWEET */
 
+#ifdef ARM64_BOARD_CONFIG_POLARIS
+#include <pexpert/arm64/POLARIS.h>
+
+#define MAX_L2_CLINE                   6
+#define MAX_CPUS                       8
+#define MAX_CPU_CLUSTERS               1
+
+#define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
+
+#endif  /* ARM64_BOARD_CONFIG_POLARIS */
+
 #ifdef ARM64_BOARD_CONFIG_VMAPPLE
 #include <pexpert/arm64/VMAPPLE.h>
