diff --git a/pexpert/pexpert/arm64/POLARIS.h b/pexpert/pexpert/arm64/POLARIS.h
new file mode 100644
index 0000000..e0d7730
--- /dev/null
+++ b/pexpert/pexpert/arm64/POLARIS.h
@@ -0,0 +1,29 @@
+/*
+ * Board config for the Xiaomi Mi Mix 2S ("polaris", Qualcomm SDM845 /
+ * Snapdragon 845): Kryo 385 = Cortex-A75 + Cortex-A55, ARMv8.2, no PAC.
+ *
+ * SDM845 shares SWEET's (Redmi Note 10 Pro / SM7150) Qualcomm-class plumbing,
+ * so we inherit SWEET.h verbatim rather than duplicating it:
+ *   - GICv3 with two security states (GICD_TYPER SecurityExtn=1): Group 0 is
+ *     TrustZone's, so every interrupt including the timer is a Group 1 IRQ
+ *     taken through sleh_irq().
+ *   - 19.2 MHz architected timer whose virtual timer PPI is INTID 19
+ *     (Qualcomm numbers the timer PPIs 1/2/3/0, so CNTV = 16 + 3 = 19).
+ *   - No pointer authentication -> kernel stays plain arm64 (see MakeInc.def).
+ * Leaving SWEET defined (SWEET.h does that) is deliberate: it keeps the shared
+ * Qualcomm platform code in the sweet patches compiling for this target too.
+ *
+ * What actually differs vs SWEET lives in the device tree (tools/mkadt.py),
+ * not here: framebuffer 0x9d400000/1080x2160 vs 0x9c000000/1080x2400, UFS
+ * aperture 0x2500 vs 0x3000, and 8 homogeneous cores either way.
+ */
+
+#ifndef _PEXPERT_ARM64_POLARIS_H
+#define _PEXPERT_ARM64_POLARIS_H
+
+#include <pexpert/arm64/SWEET.h>
+
+#define POLARIS                        1
+#define SDM845                         1
+
+#endif /* ! _PEXPERT_ARM64_POLARIS_H */
